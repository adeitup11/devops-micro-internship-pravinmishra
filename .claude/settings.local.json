{
  "env": {
    "JIRA_SITE_URL": "https://adeitup11.atlassian.net/",
    "JIRA_EMAIL": "adeitup11@gmail.com",
    "AWS_PROFILE": "default",
    "AWS_REGION": "ap-south-1"
  },
  "enabledMcpjsonServers": [
    "terraform",
    "aws"
  ],
  "permissions": {
    "allow": [
      "Bash(python3:*)",
      "Bash(open:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "command": ".claude/hooks/user-prompt-submit.sh"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "command": ".claude/hooks/pre-tool-use.sh"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "command": ".claude/hooks/post-tool-use.sh"
      }
    ]
  }
}